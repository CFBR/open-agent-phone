# ====================================
# Claude Phone — Fork Configuration
# ====================================
# Provider-agnostic, open-source, free to operate.
# Copy this to .env, customize, then run:
#   docker compose -f docker-compose.full.yml up -d

# ====================================
# Network Configuration
# ====================================

EXTERNAL_IP=10.0.0.100

# ====================================
# AI Backend (choose one)
# ====================================
#   ollama     → Local LLM (free, default, runs in Docker)
#   claude     → Claude Code CLI (needs subscription)
#   openai     → OpenAI API (set OPENAI_API_KEY)
#   openrouter → OpenRouter API (set OPENROUTER_API_KEY)
#   custom     → Any OpenAI-compatible API
#
AI_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_BACKEND_URL=
AI_API_KEY=
AI_MODEL=
CLAUDE_API_URL=http://127.0.0.1:3333
# Optional shared secret for claude-api-server. Set the same value on the
# voice server and the API server to require auth on /ask and friends.
CLAUDE_API_TOKEN=
# Bind address for claude-api-server. Keep 127.0.0.1 for all-in-one installs;
# use 0.0.0.0 only when a remote voice server must connect, and set a token.
CLAUDE_API_HOST=127.0.0.1

# ====================================
# 3CX SBC (optional, env-var config)
# ====================================

SBC_MODE=auto
SBC_FQDN=your-3cx.3cx.us
SBC_AUTH_ID=your-auth-id
SBC_PASSWORD=your-password
SBC_NAME=docker-sbc

# ====================================
# Drachtio
# ====================================

DRACHTIO_SECRET=cymru
DRACHTIO_SIP_PORT=5070

# ====================================
# FreeSWITCH
# ====================================

FREESWITCH_SECRET=JambonzR0ck$

# ====================================
# 3CX / SIP
# ====================================

SIP_DOMAIN=your-3cx-server.3cx.us
SIP_REGISTRAR=10.0.0.50
SIP_EXTENSION=9000
SIP_AUTH_ID=your-auth-id
SIP_AUTH_PASSWORD=your-password
# Outbound call target and caller ID. SIP_TRUNK_HOST defaults to SIP_REGISTRAR.
SIP_TRUNK_HOST=
DEFAULT_CALLER_ID=+15551234567

# ====================================
# STT
# ====================================
# OPENROUTER_API_KEY is set in the AI Backend section above.
LOCAL_WHISPER_URL=http://127.0.0.1:7000

# ====================================
# TTS
# ====================================

TTS_PROVIDER=kokoro
KOKORO_TTS_URL=http://127.0.0.1:8880
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ====================================
# Application
# ====================================

HTTP_PORT=3000
WS_PORT=3001
MAX_CONVERSATION_TURNS=20
OUTBOUND_RING_TIMEOUT=30
# Exit for a supervisor restart if the voice app cannot recover in this many
# milliseconds after a drachtio or FreeSWITCH disconnect. Set to 0 to disable.
RECOVERY_TIMEOUT_MS=300000
# Audio fork WebSocket tokens. Leave AUDIO_FORK_SECRET blank to use a random
# per-process secret. URLs are generated and verified by the same process.
AUDIO_FORK_SECRET=
AUDIO_FORK_TOKEN_TTL_MS=60000

# Optional shared secret for the voice-app HTTP API (/api/*).
# When set, requests must include it via the X-API-Token header or
# as `Authorization: Bearer <token>`. Leave blank to disable auth.
# VOICE_API_TOKEN=

# DEBUG=voice-app:*
